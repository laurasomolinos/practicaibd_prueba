    },
    {
      "parameters": {
        "jsCode": "const hourly = $input.first().json.hourly;\nconst result = [];\n\nfor (let i = 0; i < hourly.time.length; i++) {\n  result.push({\n    json: {\n      time: hourly.time[i],\n      pm10: hourly.pm10[i],\n      pm2_5: hourly.pm2_5[i],\n      carbon_dioxide: hourly.carbon_dioxide[i],\n      uv_index: hourly.uv_index[i],\n      olive_pollen: hourly.olive_pollen[i],\n      ozone: hourly.ozone[i],\n      methane: hourly.methane[i]\n    }\n  });\n}\n\nreturn result;"
      },
