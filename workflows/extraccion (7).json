      "id": "b2c9cc8f-91c6-42e2-96bb-d2cd1924b190",
      "name": "dia correcto tiempo"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// Sacamos todas las fechas que vienen en los items\nconst dates = items.map(item => {\n  const time = item.json.time || item.json.datetime;\n\n  if (!time) {\n    throw new Error(\"Falta el campo time/datetime en air_quality\");\n  }\n\n  return time.split(\"T\")[0];\n});\n\n// Como Open-Meteo devuelve ayer + hoy, nos quedamos con la fecha menor\nconst targetDate = [...new Set(dates)].sort()[0];\n\nconst result = items.filter(item => {\n  const time = item.json.time || item.json.datetime;\n  const itemDate = time.split(\"T\")[0];\n\n  return itemDate === targetDate;\n});\n\nreturn result;"
      },
