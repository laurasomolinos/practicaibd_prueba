    {
      "parameters": {
        "jsCode": "const hourly = $input.first().json.hourly;\nconst result = [];\n\n// Recorremos la lista de tiempos (normalmente 48 horas)\nfor (let i = 0; i < hourly.time.length; i++) {\n  result.push({\n    json: {\n      time: hourly.time[i],\n      temperature_2m: hourly.temperature_2m[i],\n      precipitation: hourly.precipitation[i]\n    }\n  });\n}\n\n// Al devolver un array, n8n crea un \"ítem\" independiente por cada elemento\nreturn result;"
      },
